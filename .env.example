# Token bot Zalo: https://bot.zaloplatforms.com > dang nhap Zalo > tao bot > copy token
# (dang 123456789:abc...). `python3 main.py --setup` se hoi va tu dien vao .env.
ZALO_BOT_TOKEN=

# ID nhom Zalo nhan link. Khong can tu tim: chay `python3 main.py --chat-id`
ZALO_CHAT_ID=

# (Tuy chon) Dia chi Ollama neu khong chay tren may nay. Mac dinh: http://127.0.0.1:11434
# OLLAMA_HOST=
